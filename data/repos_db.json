  "_meta": {
    "_comment": "Keys beginning with an underscore are metadata, not repositories. Consumers must filter them out before iterating.",
    "tiers": {
      "0": {
        "name": "Organization Portal",
        "hint": "The organization landing portal itself."
      },
      "1": {
        "name": "Core Platform & Board Contract",
        "hint": "Standard hardware driver engine and companion reference code."
      },
      "2": {
        "name": "Python Framebuffers & GUI Toolkits",
        "hint": "Zero external native dependencies — runs on any Python 3 host."
      },
      "3": {
        "name": "LVGL Native Extensions & Binding Generator",
        "hint": "Single-source LVGL C header binding generator and native interpreter modules."
      },
      "4": {
        "name": "App Hosts & Mobile",
        "hint": "Deploy PyDevices apps directly to desktop browsers or mobile APKs."
      },
      "5": {
        "name": "Developer Tools & Infrastructure",
        "hint": "MIP package indexing, multi-usermod builds, and serial/FTP IDE extensions."
      }
    },
    "excluded": {
      ".github (dotgithub)": "No landing page by design. It holds org-wide data, scripts, and community health files, and is documented as markdown only.",
      "android-runner": "Exists solely to enable pydevices/bin/android.py. The APK is documented in pydevices; the runner publishes no site."
    }
  },
